                        <div class="table-cell" data-label="Rhyno SE03 Lite">3 years</div>
                        <div class="table-cell" data-label="Rhyno SE03">3 years</div>
                        <div class="table-cell" data-label="Rhyno SE03 Max">3 years</div>
                    </div>
                    <div class="table-row">
                        <div class="table-cell" data-label="Specification">Charging time</div>
                        <div class="table-cell" data-label="Rhyno SE03 Lite">3 hours (12A)</div>
                        <div class="table-cell" data-label="Rhyno SE03">4 hours (12A)</div>
                        <div class="table-cell" data-label="Rhyno SE03 Max">4 hours (12A)</div>
                    </div>
                    <div class="table-row">
                        <div class="table-cell" data-label="Specification">Motor</div>
                        <div class="table-cell" data-label="Rhyno SE03 Lite">1500W</div>
                        <div class="table-cell" data-label="Rhyno SE03">1500W</div>
                        <div class="table-cell" data-label="Rhyno SE03 Max">2000W</div>
                    </div>
                    <div class="table-row">
                        <div class="table-cell" data-label="Specification">Max speed</div>
                        <div class="table-cell" data-label="Rhyno SE03 Lite">55 km/h</div>
                        <div class="table-cell" data-label="Rhyno SE03">55 km/h</div>
                        <div class="table-cell" data-label="Rhyno SE03 Max">65 km/h</div>
                    </div>
                    <div class="table-row">
                        <div class="table-cell" data-label="Specification">Warranty on electronics</div>
                        <div class="table-cell" data-label="Rhyno SE03 Lite">1 year</div>
                        <div class="table-cell" data-label="Rhyno SE03">1 year</div>
                        <div class="table-cell" data-label="Rhyno SE03 Max">1 year</div>
                    </div>
                    <div class="table-row">
