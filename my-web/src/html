                        <div class="table-cell" data-label="Rhyno SE03">2.7Kwh</div>
                        <div class="table-cell" data-label="Rhyno SE03 Max">2.7Kwh</div>
                    </div>
                    <div class="table-row">
                        <div class="table-cell" data-label="Specification">Battery features</div>
