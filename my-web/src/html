    <section class="comparison">
        <h2>Compare All Models</h2>
        <table>
            <style>
                body {
                    font-family: Arial, sans-serif;
                    margin: 20px;
                    padding: 0;
                }
                .table-container {
                    display: flex;
                    flex-wrap: wrap;
                    justify-content: center;
                }
                .table {
                    display: table;
                    border-collapse: collapse;
                    width: 100%;
                    max-width: 800px;
                }
                .table-row {
                    display: table-row;
                }
                .table-cell {
                    display: table-cell;
                    padding: 10px;
                    text-align: center;
                    vertical-align: top;
                    border-bottom: 1px solid transparent;
                }
                .table-cell-header {
                    font-weight: bold;
                    background-color: #f4f4f4;
                    border-bottom: 2px solid #ddd;
                }
                .table-cell img {
                    max-width: 100px;
                    display: block;
                    margin: 0 auto;
                }
                @media (max-width: 600px) {
                    .table {
                        width: 100%;
                    }
                    .table-cell {
                        display: block;
                        width: 100%;
                        box-sizing: border-box;
                        padding: 10px 5px;
                    }
                    .table-cell-header {
                        display: none;
                    }
                    .table-cell::before {
                        content: attr(data-label);
                        font-weight: bold;
                        display: block;
                        margin-bottom: 5px;
                    }
                }
            </style>
        
            <h1>Comparison Table</h1>
        
            <div class="table-container">
                <div class="table">
                    <div class="table-row">
                        <div class="table-cell table-cell-header">Specification</div>
